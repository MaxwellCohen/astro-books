---
type Props = {
  id: string;
  label: string;
  name: 'delay' | 'pages' | 'rating' | 'year';
  readout: string;
  value: number;
  values: readonly number[];
  hintStart: string;
  hintEnd: string;
};

const { id, label, name, readout, value, values, hintStart, hintEnd } = Astro.props;

let index = values.indexOf(value);
if (index < 0) {
  let distance = Number.POSITIVE_INFINITY;
  index = 0;
  values.forEach((candidate, i) => {
    const next = Math.abs(candidate - value);
    if (next < distance) {
      index = i;
      distance = next;
    }
  });
}
---

<div class="flex flex-col gap-2">
  <div class="flex items-baseline justify-between gap-2">
    <label class="text-muted text-xs font-semibold tracking-wide uppercase" for={id}>{label}</label>
    <span class="text-sm font-medium text-black tabular-nums dark:text-white" data-readout={id}>{readout}</span>
  </div>
  <input
    class="focus-visible:ring-accent/30 cursor-pointer rounded-full focus-visible:ring-2 focus-visible:outline-none"
    data-range={name}
    data-values={JSON.stringify(values)}
    id={id}
    max={values.length - 1}
    min={0}
    step={1}
    type="range"
    value={index}
  />
  <div class="text-muted flex justify-between text-[11px] tabular-nums">
    <span>{hintStart}</span>
    <span>{hintEnd}</span>
  </div>
</div>
